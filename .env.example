# Copy this file to .env before first start.
# For a public Git repository, NEVER commit .env.

COMPOSE_PROJECT_NAME=catering-analytics

# PostgreSQL analytics platform
POSTGRES_DB=analytics
POSTGRES_ADMIN_USER=platform_admin
POSTGRES_ADMIN_PASSWORD=ChangeMe_Admin_2026!
POSTGRES_PORT=5432
INGEST_USER=ingest_user
INGEST_PASSWORD=ChangeMe_Ingest_2026!
DBT_USER=dbt_user
DBT_PASSWORD=ChangeMe_Dbt_2026!
BI_READER_USER=bi_reader
BI_READER_PASSWORD=ChangeMe_BI_2026!

# MinIO (local prototype only)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=ChangeMe_MinIO_Root_2026!
MINIO_PIPELINE_USER=pipeline
MINIO_PIPELINE_PASSWORD=ChangeMe_MinIO_Pipeline_2026!
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_RAW_BUCKET=landing
MINIO_CURATED_BUCKET=curated
MINIO_QUARANTINE_BUCKET=quarantine

# Synthetic source batch sizing
ORDER_COUNT=5000
CUSTOMER_COUNT=250
PRODUCT_COUNT=80
BAD_RECORD_PERCENT=0
GENERATOR_SEED=42

# Superset
SUPERSET_PORT=8088
SUPERSET_SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_42_CHARACTERS
SUPERSET_ADMIN_USERNAME=admin
SUPERSET_ADMIN_PASSWORD=ChangeMe_Superset_2026!
SUPERSET_ADMIN_FIRSTNAME=Data
SUPERSET_ADMIN_LASTNAME=Engineer
SUPERSET_ADMIN_EMAIL=admin@example.local
SUPERSET_META_PASSWORD=ChangeMe_SupersetMeta_2026!

# Apache Hop Web
HOP_WEB_PORT=8080

# Logging
LOG_LEVEL=INFO
